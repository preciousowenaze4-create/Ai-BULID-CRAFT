# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, add GEMINI_API_KEY or VITE_GEMINI_API_KEY in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Supabase backend project URL for authentication & user_tokens
SUPABASE_URL="https://dnzepbphxzyxhpzsytbu.supabase.co"
VITE_SUPABASE_URL="https://dnzepbphxzyxhpzsytbu.supabase.co"

# SUPABASE_ANON_KEY: Supabase anon key for backend auth & user_tokens
SUPABASE_ANON_KEY="sb_publishable_yI7kSJEuVGq_ZE8-JCAXHw_SLca40z1"
VITE_SUPABASE_ANON_KEY="sb_publishable_yI7kSJEuVGq_ZE8-JCAXHw_SLca40z1"

# UNREAL_SPEECH_API_KEY: Optional API key for Unreal Speech / Kokoro TTS voice stream
UNREAL_SPEECH_API_KEY=""

# PAYSTACK_PUBLIC_KEY: Official Paystack Publishable Key for client-side checkout
PAYSTACK_PUBLIC_KEY="pk_test_b8e210137ad2411082cebb1c43d83921b7123456"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_b8e210137ad2411082cebb1c43d83921b7123456"

# PAYSTACK_SECRET_KEY: Official Paystack Secret Key for backend transaction verification
PAYSTACK_SECRET_KEY=""

